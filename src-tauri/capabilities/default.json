{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Purple main window: receive desktop lifecycle and media events. Every backend call goes through an explicit command.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://opencollective.com/tidalcycles" }]
    }
  ]
}
