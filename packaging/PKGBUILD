# Maintainer: Ferdous Bhai <ferdousbd@gmail.com>
pkgname=purple-music
_upstream=purple
_app_id=com.soundspurple.Purple
_pnpm_ver=10.27.0
pkgver=0.4.0
pkgrel=1
pkgdesc="AI-powered music production: describe music in plain language and hear Strudel patterns play"
arch=('x86_64')
url="https://github.com/ferdousbhai/$_upstream"
license=('MIT AND AGPL-3.0-or-later')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-plugins-base'
  'gst-plugins-good'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
)
optdepends=('org.freedesktop.secrets: store the Gemini key in a desktop keyring instead of the permission-protected file fallback')
makedepends=('cargo' 'cargo-auditable' 'nodejs')
checkdepends=('appstream' 'desktop-file-utils')
source=(
  "$_upstream-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "pnpm-$_pnpm_ver.tar.gz::https://registry.npmjs.org/pnpm/-/pnpm-$_pnpm_ver.tgz"
)
# Refresh the upstream checksum with `updpkgsums` after pushing a release tag.
# Release and pnpm sources must never be verified by SKIP.
sha256sums=(
  '9387f1b9f094ebfd6ae026c74f16e8f116301c8b350cd2d9b0acb481acfc4578'
  'd3c7c3d12d87d177e32f01748d5994fb20cd5becf11670ee60530c374ffeabb3'
)

prepare() {
  cd "$srcdir/$_upstream-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable

  cargo fetch --locked \
    --manifest-path src-tauri/Cargo.toml \
    --target "$(rustc -vV | sed -n 's/host: //p')"
  node "$srcdir/package/bin/pnpm.cjs" fetch \
    --frozen-lockfile \
    --ignore-scripts \
    --store-dir "$srcdir/pnpm-store"
}

build() {
  cd "$srcdir/$_upstream-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  export RUSTUP_TOOLCHAIN=stable

  node "$srcdir/package/bin/pnpm.cjs" install \
    --frozen-lockfile \
    --offline \
    --store-dir "$srcdir/pnpm-store"
  node "$srcdir/package/bin/pnpm.cjs" run build:webview
  cargo auditable build --frozen --release --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "$srcdir/$_upstream-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  export RUSTUP_TOOLCHAIN=stable

  node "$srcdir/package/bin/pnpm.cjs" run lint
  node "$srcdir/package/bin/pnpm.cjs" run test
  node "$srcdir/package/bin/pnpm.cjs" run typecheck
  cargo test --frozen --release --manifest-path src-tauri/Cargo.toml
  desktop-file-validate "packaging/$_app_id.desktop"
  appstreamcli validate --no-net "packaging/$_app_id.metainfo.xml"
}

package() {
  cd "$srcdir/$_upstream-$pkgver"

  install -Dm755 "$srcdir/target/release/purple" "$pkgdir/usr/bin/purple-music"
  install -Dm644 "packaging/$_app_id.desktop" \
    "$pkgdir/usr/share/applications/$_app_id.desktop"
  install -Dm644 "packaging/$_app_id.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_app_id.metainfo.xml"
  install -Dm644 assets/purple.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_app_id.svg"

  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/$_app_id.png"
  install -Dm644 src-tauri/icons/64x64.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/$_app_id.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_app_id.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_app_id.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-AGPL-3.0-or-later \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-AGPL-3.0-or-later"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
