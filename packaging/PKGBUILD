# Maintainer: Ferdous Bhai <ferdousbd@gmail.com>
pkgname=purple
pkgver=0.4.0
pkgrel=1
pkgdesc="AI-powered music production: describe music in plain language and hear Strudel patterns play"
arch=('x86_64')
url="https://github.com/ferdousbhai/purple"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gst-plugins-base'
  'gst-plugins-good'
  'libsecret'
  'hicolor-icon-theme'
)
makedepends=('rust' 'nodejs' 'pnpm')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Refresh with `updpkgsums` after pushing the tag for a new pkgver. A release
# tarball must never be verified by SKIP.
sha256sums=('9387f1b9f094ebfd6ae026c74f16e8f116301c8b350cd2d9b0acb481acfc4578')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  pnpm install --frozen-lockfile
  pnpm run build:webview
  cargo build --release --locked --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  pnpm run test
  cargo test --release --locked --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 src-tauri/target/release/purple "$pkgdir/usr/bin/purple"
  install -Dm644 packaging/purple.desktop "$pkgdir/usr/share/applications/purple.desktop"
  install -Dm644 assets/purple.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/purple.svg"

  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/purple.png"
  install -Dm644 src-tauri/icons/64x64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/purple.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/purple.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/purple.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
