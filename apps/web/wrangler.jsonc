{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker: the app is a static SPA. There is no server code at
  // all — patterns, chat and the Gemini key live in the visitor's browser,
  // and generation requests go straight to Google.
  "name": "purple-web",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "soundspurple.com", "custom_domain": true },
    { "pattern": "www.soundspurple.com", "custom_domain": true }
  ]
}
