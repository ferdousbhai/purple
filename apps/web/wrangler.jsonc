{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Gemini key, chat, library and inference remain browser-only. A pattern
  // title and code reach D1 only after the visitor explicitly shares them.
  // The feedback route sends only its submitted fields to a fixed destination.
  "name": "purple-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "preview_urls": true,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run only app documents and APIs through Worker logic. Matching static
    // assets and the standalone 404 page stay on Cloudflare's asset fast path.
    "run_worker_first": ["/", "/patterns", "/llms.txt", "/api/*", "/mcp", "/mcp/*", "/link/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_LINK",
        "class_name": "AgentLinkSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentLinkSession"]
    }
  ],
  "d1_databases": [
    {
      "binding": "PATTERNS_DB",
      "database_name": "purple-patterns",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "ferdous@hey.com",
      "allowed_sender_addresses": ["feedback@soundspurple.com"]
    }
  ],
  "secrets": {
    "required": ["TURNSTILE_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "routes": [
    { "pattern": "soundspurple.com", "custom_domain": true },
    { "pattern": "www.soundspurple.com", "custom_domain": true }
  ]
}
