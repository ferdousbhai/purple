{
  "name": "riff",
  "version": "0.2.0",
  "description": "AI-powered music production — Cursor for music",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"vite --host 127.0.0.1\" \"bun scripts/dev-hmr.ts\"",
    "build:web": "vite build",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable",
    "package:linux": "scripts/package-linux-user.sh",
    "reinstall:linux": "scripts/reinstall-linux-user.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run test && pnpm run typecheck && pnpm run build:web"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@riff/core": "workspace:*",
    "@strudel/web": "1.3.0",
    "electrobun": "1.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "react-resizable-panels": "^4.11.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
