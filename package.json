{
  "name": "riff",
  "version": "0.3.0",
  "description": "AI-powered music production — Cursor for music",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run test && pnpm run test:rust && pnpm run typecheck && pnpm run build:web"
  },
  "dependencies": {
    "@riff/core": "workspace:*",
    "@strudel/web": "1.3.0",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^6.0.1",
    "react-resizable-panels": "^4.11.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
