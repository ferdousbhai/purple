{
  "name": "purple",
  "version": "0.4.0",
  "description": "Local-first AI music production in the browser",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "pnpm --filter @purple/web run dev",
    "build": "pnpm --filter @purple/web run build",
    "preview": "pnpm --filter @purple/web run preview",
    "deploy": "pnpm --filter @purple/web run deploy",
    "web:check": "pnpm --filter @purple/web run check",
    "test": "vitest run",
    "test:browser": "pnpm --filter @purple/web run test:browser",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run build",
    "lint": "oxlint && pnpm run lint:text && pnpm run lint:duplicates",
    "lint:duplicates": "jscpd apps packages scripts tools",
    "lint:text": "node scripts/check-no-em-dash.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/react": "^19.2.14",
    "jscpd": "4.0.5",
    "oxlint": "1.78.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  }
}
